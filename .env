# Committed defaults — Sanity values only (all public, non-secret).
# These keep the build + /admin working even if .env.local is missing
# (e.g. after a fresh clone). Vercel dashboard env vars override these.
# Secrets (FORMSPREE_ENDPOINT) belong in .env.local / Vercel env, never here.
NEXT_PUBLIC_SANITY_PROJECT_ID=ej5ob7dg
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01
